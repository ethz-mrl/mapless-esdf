# The library plus its ROS 2 node, built into an overlay workspace.
#
#   docker build -f Dockerfile.ros -t cuda-depth-buffer:ros .
#   docker run --rm --gpus all -it --net=host --ipc=host cuda-depth-buffer:ros \
#     ros2 launch cuda_depth_buffer_ros depth_buffer.launch.py
#
# --ipc=host matters: the node is a component so it can be composed into the
# same process as a camera driver, and the middleware's shared memory transport
# needs the host IPC namespace when it cannot be.
ARG CUDA_IMAGE=nvidia/cuda:13.0.1-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

ARG ROS_DISTRO=jazzy
ARG CUDA_ARCHITECTURES="75;80;86;87;89;120"
ENV ROS_DISTRO=${ROS_DISTRO}
ENV CMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake curl git gnupg lsb-release \
      libeigen3-dev libgtest-dev libyaml-cpp-dev ninja-build \
      pybind11-dev python3-dev python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 from the official apt repository.
RUN curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo ${UBUNTU_CODENAME}) main" \
      > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      ros-${ROS_DISTRO}-ros-base \
      ros-${ROS_DISTRO}-cv-bridge \
      ros-${ROS_DISTRO}-image-transport \
      ros-${ROS_DISTRO}-rclcpp-components \
      ros-${ROS_DISTRO}-ros2bag \
      ros-${ROS_DISTRO}-rosbag2-storage-mcap \
      ros-${ROS_DISTRO}-rviz2 \
      ros-${ROS_DISTRO}-tf2-ros \
      ros-${ROS_DISTRO}-visualization-msgs \
      python3-colcon-common-extensions \
      python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# The library first, installed where the ROS packages can find_package it.
COPY CMakeLists.txt /src/cuda-depth-buffer/
COPY cmake /src/cuda-depth-buffer/cmake
COPY include /src/cuda-depth-buffer/include
COPY src /src/cuda-depth-buffer/src
COPY python /src/cuda-depth-buffer/python
RUN cmake -S /src/cuda-depth-buffer -B /tmp/build -GNinja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/cuda_depth_buffer \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
      -DCUDA_DEPTH_BUFFER_BUILD_TESTS=OFF \
      -DCUDA_DEPTH_BUFFER_BUILD_EXAMPLES=OFF \
      -DCUDA_DEPTH_BUFFER_BUILD_PYTHON=ON \
    && cmake --build /tmp/build --target install \
    && rm -rf /tmp/build /src

ENV CMAKE_PREFIX_PATH=/opt/cuda_depth_buffer
ENV LD_LIBRARY_PATH=/opt/cuda_depth_buffer/lib
# The Python bindings go in beside the library rather than into ROS's own
# interpreter, so `import cuda_depth_buffer` works without touching the system
# packages. The bag generator in examples/ros needs them to render its scene.
ENV PYTHONPATH=/opt/cuda_depth_buffer

COPY ros /ws/src
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build --base-paths /ws/src --build-base /ws/build \
       --install-base /ws/install --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf /ws/build /ws/log

COPY examples/ros /ws/examples
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
