@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CUDAToolkit)
find_dependency(Eigen3 3.3 NO_MODULE)
# Private to the library, but a static archive still needs it at link time.
find_dependency(yaml-cpp)

include("${CMAKE_CURRENT_LIST_DIR}/cuda_depth_buffer-targets.cmake")
check_required_components(cuda_depth_buffer)
