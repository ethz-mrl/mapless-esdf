# Everything needed to build the library, run its tests and open the notebook.
#
#   docker build -f Dockerfile.dev -t cuda-depth-buffer:dev .
#   docker run --rm --gpus all -it -v "$PWD:/workspace" cuda-depth-buffer:dev
#
# The GPU is only needed to run, not to build: CUDA_ARCHITECTURES is a build
# argument because `native` cannot detect a device that docker build never sees.
ARG CUDA_IMAGE=nvidia/cuda:13.0.1-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

ARG CUDA_ARCHITECTURES="75;80;86;87;89;120"
ENV CMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      libeigen3-dev \
      libgtest-dev \
      libyaml-cpp-dev \
      ninja-build \
      pkg-config \
      python3-dev \
      python3-pip \
      python3-venv \
      pybind11-dev \
    && rm -rf /var/lib/apt/lists/*

# A virtualenv rather than --break-system-packages: Ubuntu 24.04 marks its
# python externally managed, and the notebook wants versions apt does not have.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
RUN pip install --no-cache-dir \
      numpy \
      pytest \
      scikit-build-core \
      pybind11 \
      matplotlib \
      ipywidgets \
      jupyterlab \
      nbclient

WORKDIR /workspace
CMD ["/bin/bash"]
